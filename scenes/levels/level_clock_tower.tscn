[node name="LevelClockTower" instance=ExtResource("1_base")]
level_name = "Clock Tower"
description = "Chapter 3's machine. A clock around the boss: the minute hand sweeps the outer ring and the hour hand steps round the inner ring, hiding the hour lights as they pass. Twelve hours pass in six minutes, then five once the boss shows itself, and the bell strikes each hour, shaking the table once per chime. A winding ramp from the right wall loops all the way round the clock, crosses over itself, comes down the left side and fires the ball across at the right slingshot. Once the boss shows himself, every third loop makes him spin, blink and shake, then take twice your score as damage. Below the clock, the Escapement catches the ball and sends it back up to the top: it comes out near a side wall, level with the top bumpers, fired at the boss."
art_rings = PackedVector3Array(280, 370, 170, 280, 370, 115, 280, 370, 60)
art_title = "TEMPUS"
loop_strike_every = 3
stage_music = PackedStringArray("res://assets/music/clock_stage.wav", "res://assets/music/clock_stage_slow.wav")
boss_music = PackedStringArray("res://assets/music/clock_boss.wav", "res://assets/music/clock_boss_mid.wav")

